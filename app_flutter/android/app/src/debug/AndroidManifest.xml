<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Flutter 3.44's integration_test Android library declares minSdk 24.
         The product app still supports minSdk 23; this override is debug-only
         and exists so CI/JVM debug builds can keep the integration_test
         dev dependency without changing release/product minSdk semantics. -->
    <uses-sdk tools:overrideLibrary="dev.flutter.integration_test" />
</manifest>
